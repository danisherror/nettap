   "seed": 1765070035,
   "version": 1,
   "versionNonce": 957006265,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "WHY\n\u2022 Polling stays the source of truth. Events only cut the delay: a new container\n  is captured in about a second instead of up to 5s.\n\u2022 A missed or dropped event costs at most one poll interval, so errors are only\n  logged at debug level.",
   "originalText": "WHY\n\u2022 Polling stays the source of truth. Events only cut the delay: a new container\n  is captured in about a second instead of up to 5s.\n\u2022 A missed or dropped event costs at most one poll interval, so errors are only\n  logged at debug level.",
   "fontSize": 15,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "middle",
   "containerId": "hld-rectangle-74",
   "lineHeight": 1.25,
   "autoResize": true
  },
