   "roundness": null,
   "seed": 886441858,
   "version": 1,
   "versionNonce": 822138090,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "NOTES\n\u2022 Hostnames come from captured traffic, so they're escaped (utils.printable /\n  html.escape) before printing.\n\u2022 Port-scoped captures get a note saying traffic was picked out by port.",
   "originalText": "NOTES\n\u2022 Hostnames come from captured traffic, so they're escaped (utils.printable /\n  html.escape) before printing.\n\u2022 Port-scoped captures get a note saying traffic was picked out by port.",
   "fontSize": 15,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "middle",
   "containerId": "hld-rectangle-619",
   "lineHeight": 1.25,
   "autoResize": true
  },
