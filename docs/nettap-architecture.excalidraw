  {
   "id": "hld-text-614",
   "type": "text",
   "x": 139.28000000000003,
   "y": 12872.875,
   "width": 656.88,
   "height": 21.25,
   "angle": 0,
   "strokeColor": "#495057",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 195623613,
