   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "WHY TSHARK\n\u2022 Its dissectors already get DNS, TLS SNI and HTTP Host right. Swapping to\n  Zeek/Suricata would only touch this file and FIELDS.\nFAILURE\n\u2022 tshark timeout (120s) or non-zero exit \u2192 logged, returns no rows.",
   "originalText": "WHY TSHARK\n\u2022 Its dissectors already get DNS, TLS SNI and HTTP Host right. Swapping to\n  Zeek/Suricata would only touch this file and FIELDS.\nFAILURE\n\u2022 tshark timeout (120s) or non-zero exit \u2192 logged, returns no rows.",
   "fontSize": 15,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "middle",
   "containerId": "hld-rectangle-337",
   "lineHeight": 1.25,
   "autoResize": true
  },
