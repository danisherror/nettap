  {
   "id": "hld-text-160",
   "type": "text",
   "x": 182.96000000000004,
   "y": 4447.125,
   "width": 771.1200000000001,
   "height": 21.25,
   "angle": 0,
   "strokeColor": "#495057",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
