   "versionNonce": 685665214,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "turns analyze output into a summary a non-technical reader can follow",
   "originalText": "turns analyze output into a summary a non-technical reader can follow",
   "fontSize": 17,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
   "id": "hld-rectangle-615",
   "type": "rectangle",
   "x": -70,
   "y": 12913.875,
   "width": 2070,
   "height": 210.0,
   "angle": 0,
   "strokeColor": "#343a40",
   "backgroundColor": "#f8f9fa",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": {
    "type": 3
   },
   "seed": 513520418,
   "version": 1,
   "versionNonce": 790929686,
   "isDeleted": false,
   "boundElements": [
    {
     "id": "hld-text-616",
     "type": "text"
    }
   ],
   "updated": 1,
   "link": null,
   "locked": false
  },
  {
   "id": "hld-text-616",
   "type": "text",
   "x": -62,
   "y": 12928.875,
   "width": 2054,
   "height": 180.0,
   "angle": 0,
   "strokeColor": "#343a40",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 554818646,
   "version": 1,
   "versionNonce": 1738084018,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "WHAT THIS COMPONENT DOES\nWrites a summary for someone who doesn't know networking: how much the container sent and received, which other containers and internet sites it\ntalked to (with names), what it looked up in DNS, and which protocols it used. It gathers the numbers with analyze.py into one dict, separates\ninternet destinations from local ones, and renders either plain text for the terminal or one self-contained HTML file you can double-click (no server\nor internet connection needed).\n\nIN: a container name, the SQLite database\nOUT: text on the terminal, or an .html file in the data directory\nCALLED BY: `nettap report`",
   "originalText": "WHAT THIS COMPONENT DOES\nWrites a summary for someone who doesn't know networking: how much the container sent and received, which other containers and internet sites it\ntalked to (with names), what it looked up in DNS, and which protocols it used. It gathers the numbers with analyze.py into one dict, separates\ninternet destinations from local ones, and renders either plain text for the terminal or one self-contained HTML file you can double-click (no server\nor internet connection needed).\n\nIN: a container name, the SQLite database\nOUT: text on the terminal, or an .html file in the data directory\nCALLED BY: `nettap report`",
   "fontSize": 16,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "middle",
   "containerId": "hld-rectangle-615",
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
   "id": "hld-rectangle-617",
   "type": "rectangle",
   "x": 1330,
   "y": 13173.875,
   "width": 660,
   "height": 196.75,
   "angle": 0,
   "strokeColor": "#1864ab",
   "backgroundColor": "#e7f5ff",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": {
    "type": 3
   },
   "seed": 1223244794,
   "version": 1,
   "versionNonce": 434096300,
   "isDeleted": false,
   "boundElements": [
    {
     "id": "hld-text-618",
     "type": "text"
    }
   ],
   "updated": 1,
   "link": null,
   "locked": false
  },
  {
   "id": "hld-text-618",
   "type": "text",
   "x": 1338,
   "y": 13187.875,
   "width": 644,
   "height": 168.75,
   "angle": 0,
   "strokeColor": "#1864ab",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 1905358007,
   "version": 1,
   "versionNonce": 43125184,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "STEP BY STEP (numbers match the badges)\n1. Pick a container, and text or HTML.\n2. Count total packets and bytes, find its own IPs, split bytes into sent and\n    received.\n3. Get peers, external destinations, DNS lookups and the protocol mix from\n    analyze.py.\n4. Split destinations into internet and local network.\n5. Render readable sentences for the terminal.\n6. Render one HTML file with inline styles and bar charts.",
   "originalText": "STEP BY STEP (numbers match the badges)\n1. Pick a container, and text or HTML.\n2. Count total packets and bytes, find its own IPs, split bytes into sent and\n    received.\n3. Get peers, external destinations, DNS lookups and the protocol mix from\n    analyze.py.\n4. Split destinations into internet and local network.\n5. Render readable sentences for the terminal.\n6. Render one HTML file with inline styles and bar charts.",
   "fontSize": 15,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "middle",
   "containerId": "hld-rectangle-617",
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
   "id": "hld-rectangle-619",
   "type": "rectangle",
   "x": 1330,
   "y": 13400.625,
   "width": 660,
   "height": 103.0,
   "angle": 0,
