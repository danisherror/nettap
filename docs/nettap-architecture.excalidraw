   "versionNonce": 418341499,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "tcpdump -i <iface>\n-w <name>_%ts.pcap\n-G 60 rotate \u00b7 -U flush\n-n \u00b7 -Z root",
   "originalText": "tcpdump -i <iface>\n-w <name>_%ts.pcap\n-G 60 rotate \u00b7 -U flush\n-n \u00b7 -Z root",
   "fontSize": 15,
   "fontFamily": 2,
   "textAlign": "center",
   "verticalAlign": "middle",
   "containerId": "hld-rectangle-233",
   "lineHeight": 1.25,
   "autoResize": true
