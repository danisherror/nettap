   "link": null,
   "locked": false
  },
  {
   "id": "hld-text-380",
   "type": "text",
   "x": 1730.0,
   "y": 8868.375,
   "width": 644,
   "height": 150.0,
   "angle": 0,
   "strokeColor": "#f08c00",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
