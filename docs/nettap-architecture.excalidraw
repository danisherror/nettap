     "id": "hld-text-289",
     "type": "text"
    }
   ],
   "updated": 1,
   "link": null,
   "locked": false
  },
  {
   "id": "hld-text-289",
   "type": "text",
   "x": 1746.8000000000002,
   "y": 7156.125,
   "width": 644,
   "height": 168.75,
   "angle": 0,
   "strokeColor": "#f08c00",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 1201546738,
   "version": 1,
   "versionNonce": 1917176626,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "KEY IDEA\n\u2022 Rows and the new offset are saved in one transaction, so a packet is never\n  counted twice - after a restart, or when `nettap enrich` and the daemon look at\n  the same file.\n\u2022 final=True once a file has rotated: take every complete record and mark it\n  done.\nTRADE-OFFS\n\u2022 The 2s hold-back gives the port sampler time to record a packet's port.\n\u2022 A TLS ClientHello split across two chunks can lose its SNI.",
   "originalText": "KEY IDEA\n\u2022 Rows and the new offset are saved in one transaction, so a packet is never\n  counted twice - after a restart, or when `nettap enrich` and the daemon look at\n  the same file.\n\u2022 final=True once a file has rotated: take every complete record and mark it\n  done.\nTRADE-OFFS\n\u2022 The 2s hold-back gives the port sampler time to record a packet's port.\n\u2022 A TLS ClientHello split across two chunks can lose its SNI.",
   "fontSize": 15,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "middle",
   "containerId": "hld-rectangle-288",
   "lineHeight": 1.25,
   "autoResize": true
  },
