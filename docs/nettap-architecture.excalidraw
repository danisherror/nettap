  {
   "id": "hld-text-75",
   "type": "text",
   "x": 1338,
   "y": 3276.625,
   "width": 644,
   "height": 93.75,
   "angle": 0,
   "strokeColor": "#f08c00",
   "backgroundColor": "transparent",
