   "locked": false
  },
  {
   "id": "hld-text-234",
   "type": "text",
   "x": 1048.4,
   "y": 5828.875,
   "width": 240.8,
   "height": 75.0,
   "angle": 0,
   "strokeColor": "#2f9e44",
