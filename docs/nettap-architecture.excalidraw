   "locked": false
  },
  {
   "id": "hld-text-620",
   "type": "text",
   "x": 1338,
   "y": 13414.625,
   "width": 644,
   "height": 75.0,
   "angle": 0,
   "strokeColor": "#f08c00",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
