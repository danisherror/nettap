   "roundness": null,
   "seed": 1183368988,
   "version": 1,
   "versionNonce": 2100349883,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "PROBLEM\n\u2022 A host-network capture sees the whole Docker host. Without filtering, every\n  container's traffic would be labelled as the target.\nLIMITS\n\u2022 A connection opened and closed between two samples is missed; listening ports\n  are reliable, short outgoing requests may not be.\n\u2022 ICMP and ARP are dropped (no port). ss needs nettap in the host's cgroup\n  namespace.",
   "originalText": "PROBLEM\n\u2022 A host-network capture sees the whole Docker host. Without filtering, every\n  container's traffic would be labelled as the target.\nLIMITS\n\u2022 A connection opened and closed between two samples is missed; listening ports\n  are reliable, short outgoing requests may not be.\n\u2022 ICMP and ARP are dropped (no port). ss needs nettap in the host's cgroup\n  namespace.",
   "fontSize": 15,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "middle",
   "containerId": "hld-rectangle-379",
   "lineHeight": 1.25,
   "autoResize": true
  },
