   "link": null,
   "locked": false,
   "text": "WHAT THIS COMPONENT DOES\nA shared toolbox with no state of its own: running shell commands safely, setting up logging, parsing 'key=value,key2=value2' label selectors, making\ntext taken from captured traffic safe to print, and formatting byte counts and tables for people.\n\nUSED BY: discovery.py, cli.py, analyze.py, report.py",
   "originalText": "WHAT THIS COMPONENT DOES\nA shared toolbox with no state of its own: running shell commands safely, setting up logging, parsing 'key=value,key2=value2' label selectors, making\ntext taken from captured traffic safe to print, and formatting byte counts and tables for people.\n\nUSED BY: discovery.py, cli.py, analyze.py, report.py",
   "fontSize": 16,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "middle",
   "containerId": "hld-rectangle-657",
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
   "id": "hld-rectangle-659",
   "type": "rectangle",
   "x": 1330,
   "y": 13855.625,
   "width": 660,
   "height": 140.5,
   "angle": 0,
   "strokeColor": "#1864ab",
   "backgroundColor": "#e7f5ff",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": {
    "type": 3
   },
   "seed": 1390169496,
   "version": 1,
   "versionNonce": 1817863193,
   "isDeleted": false,
   "boundElements": [
