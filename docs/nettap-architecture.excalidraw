   ],
   "updated": 1,
   "link": null,
   "locked": false
  },
  {
   "id": "hld-text-660",
   "type": "text",
   "x": 1338,
   "y": 13869.625,
   "width": 644,
   "height": 112.5,
   "angle": 0,
   "strokeColor": "#1864ab",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 1642396658,
   "version": 1,
   "versionNonce": 1921754975,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "STEP BY STEP (numbers match the badges)\n1. Run a command with a timeout; raise with its stderr if it fails.\n2. One log format for every module; parse label selectors.\n3. Escape control characters in traffic-derived text so they can't take over the\n    terminal.\n4. Human-readable sizes and aligned tables.",
   "originalText": "STEP BY STEP (numbers match the badges)\n1. Run a command with a timeout; raise with its stderr if it fails.\n2. One log format for every module; parse label selectors.\n3. Escape control characters in traffic-derived text so they can't take over the\n    terminal.\n4. Human-readable sizes and aligned tables.",
   "fontSize": 15,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "middle",
   "containerId": "hld-rectangle-659",
   "lineHeight": 1.25,
   "autoResize": true
  },
