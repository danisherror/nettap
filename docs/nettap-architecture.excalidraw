  {
   "id": "hld-text-338",
   "type": "text",
   "x": 1780.4,
   "y": 8049.125,
   "width": 644,
   "height": 93.75,
   "angle": 0,
   "strokeColor": "#f08c00",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
