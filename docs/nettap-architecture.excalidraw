  },
  {
   "id": "hld-text-106",
   "type": "text",
   "x": 197.52000000000004,
   "y": 3515.375,
   "width": 761.6,
   "height": 21.25,
   "angle": 0,
   "strokeColor": "#495057",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
